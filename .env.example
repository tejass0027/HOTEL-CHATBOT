# Server
PORT=3000

# Postgres (matches docker-compose.yml — run `docker compose up -d` to start it)
DATABASE_URL="postgresql://hotelbot:hotelbot@localhost:5432/hotelbot?schema=public"

# Meta WhatsApp Cloud API (App Dashboard > WhatsApp > API Setup / Configuration)
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-yourself
WHATSAPP_APP_SECRET=from-meta-app-basic-settings
WHATSAPP_ACCESS_TOKEN=from-meta-app-temporary-or-permanent-token
WHATSAPP_PHONE_NUMBER_ID=from-meta-api-setup-page

# Order receipts — see SETUP.md "Owner order receipts" section
OWNER_WHATSAPP_NUMBER=owners-own-personal-number-not-the-bot-number
WHATSAPP_ORDER_RECEIPT_TEMPLATE_NAME=order_receipt
WHATSAPP_TEMPLATE_LANGUAGE=en_US
